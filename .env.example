# Faithscroll environment variables.
#
# Copy this file to `.env.local` (git-ignored) and fill in the values. Expo inlines every
# `EXPO_PUBLIC_*` variable into the app bundle at build time, so ONLY public values belong here.
# Never put the Supabase service-role key, OpenAI keys or any other secret in this file:
# server secrets live in Supabase Edge Function secrets (`supabase secrets set ...`).
#
# Every variable is optional. When a value is missing the related feature degrades gracefully
# and the app stays fully usable offline and signed-out.
# For EAS builds, set the same names as EAS environment variables (see docs/BACKEND.md).

# --- Supabase (accounts, cloud sync for Plus, AI gateway) -----------------------------------
# Project URL: Supabase dashboard > Project Settings > API (or Connect). https://<ref>.supabase.co
EXPO_PUBLIC_SUPABASE_URL=
# Public client key: the "anon" key or the newer "publishable" key (sb_publishable_...).
# Safe to ship ONLY because every table is protected by Row Level Security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# --- RevenueCat (Faithscroll Plus subscriptions) --------------------------------------------
# Public SDK keys: RevenueCat dashboard > Project > API keys (one per platform app).
EXPO_PUBLIC_REVENUECAT_IOS_KEY=
EXPO_PUBLIC_REVENUECAT_ANDROID_KEY=

# --- Sentry (crash reporting) ----------------------------------------------------------------
# Client DSN: Sentry > Project Settings > Client Keys (DSN). Public by design.
EXPO_PUBLIC_SENTRY_DSN=

# --- Legal & analytics -----------------------------------------------------------------------
# Public web pages linked from Settings > About and the paywall (required for App Store review).
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
# Optional privacy-focused analytics endpoint. Empty = usage events stay on the device.
EXPO_PUBLIC_ANALYTICS_URL=

# --- Server secrets (never in this file; use `supabase secrets set NAME=value`) ---------------
# These are read only by Supabase Edge Functions and must never be prefixed with EXPO_PUBLIC_:
#   OPENAI_API_KEY            OpenAI API key for transcription and AI study/recap
#   OPENAI_TEXT_MODEL         model id for structured text outputs (optional override)
#   OPENAI_TRANSCRIBE_MODEL   model id for audio transcription (optional override)
#   AI_PROVIDER               AI provider selector (currently "openai")
#   REVENUECAT_WEBHOOK_AUTH   shared secret RevenueCat sends in the webhook Authorization header
#   AI_RETENTION_SECRET       secret for the scheduled ai-retention cleanup call
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided to functions automatically.
